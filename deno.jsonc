{
  "name": "@jmondi/browser-storage",
  "version": "2.2.0",
  "exports": "./mod.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "tasks": {
    "test": "deno test --allow-env",
    "lint": "deno lint",
    "check": "deno check mod.ts index_test.ts",
    "ci": "deno fmt --check && deno lint && deno check mod.ts index_test.ts && deno test --allow-env"
  },
  "publish": {
    "include": ["mod.ts", "index.ts", "README.md", "LICENSE", "deno.jsonc"]
  },
  "fmt": {
    "exclude": ["npm/", "README.md"],
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "preserve"
  }
}
